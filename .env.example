# Copy this file to .env and fill in real values. Never commit .env.

# From the FYERS API dashboard (https://fyers.in/web/api-dashboard/user-apps)
FYERS_APP_ID=XXXXXXXXXX-200
FYERS_SECRET_KEY=your-secret-key
# Must match the redirect URL registered on the app EXACTLY (including trailing slash)
FYERS_REDIRECT_URI=http://127.0.0.1:8080/
